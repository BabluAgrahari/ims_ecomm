// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//for user model
model User {
  id        Int         @id @default(autoincrement())
  name      String
  email     String      @unique
  password  String
  phoneNo   String?
  gender    gender
  dob       DateTime?
  address   String?
  city      String?
  state     String?
  pincode   Int?
  country   String?
  status    status      @default(inactive)
  role      role
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  deletedAt DateTime?
  authToken authToken[]

  @@map("users")
}

enum gender {
  male
  female
  other
}

enum role {
  admin
  user
}

model authToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

//for user model
model category {
  id          Int       @id @default(autoincrement())
  category    String
  description String?
  status      status    @default(inactive)
  userId      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  product     product[]
}

model brand {
  id          Int       @id @default(autoincrement())
  brand       String
  description String?
  status      status    @default(inactive)
  userId      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  product     product[]
}

model unit {
  id        Int       @id @default(autoincrement())
  unit      String
  status    status    @default(inactive)
  userId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  product   product[]
}

model product {
  id             Int              @id @default(autoincrement())
  name           String
  sku            String
  description    String?
  specification  String?
  categoryId     Int
  category       category         @relation(fields: [categoryId], references: [id])
  brandId        Int
  brand          brand            @relation(fields: [brandId], references: [id])
  unitId         Int
  unit           unit             @relation(fields: [unitId], references: [id])
  thumbnail      String?
  status         status           @default(inactive)
  userId         Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  deletedAt      DateTime?
  productToImage productToImage[]
}

model productToImage {
  id        Int       @id @default(autoincrement())
  productId Int
  product   product   @relation(fields: [productId], references: [id])
  image     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
}

enum status {
  inactive @map("0")
  active   @map("1")
}
